    {
      "name": "search_catalog",
      "title": "Search catalog",
      "description": "Search catalog. Recorded user flow submitted #search-catalog via fetch GET /api/products. Inputs: q (Search), category (Category).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "description": "Search"
          },
          "category": {
            "type": "string",
            "description": "Category",
            "enum": [
              "all",
              "drinkware",
              "textiles"
            ]
          }
        },
        "required": [
          "q",
          "category"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "untrustedContentHint": false,
        "consequentialHint": false,
        "debugging": false
      },
      "exampleInput": {
        "q": "cedar",
        "category": "drinkware"
      },
      "plan": {
        "formSelector": "#search-catalog",
        "resultTarget": "search-results",
        "fields": [
          {
            "name": "q",
            "kind": "string",
            "required": true
          },
          {
            "name": "category",
            "kind": "string",
            "required": true
          }
        ],
        "expect": {
          "method": "GET",
          "pathname": "/api/products",
          "transport": "fetch",
          "status": 200,
          "responseKeys": [
            "products"
          ],
          "ui": "results"
        }
      },
      "order": 2
    },
    {
      "name": "add_to_cart",
      "title": "Add to cart",
      "description": "Add to cart. Recorded user flow submitted #add-to-cart via fetch POST /api/cart. Inputs: sku (Product), size (Size), glaze (Glaze), qty (Quantity).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "description": "Product",
            "enum": [
              "cedar-mug",
              "linen-towel",
              "ash-bowl",
              "wool-cap"
            ]
          },
          "size": {
            "type": "string",
            "description": "Size",
            "enum": [
              "M",
              "L"
            ]
          },
          "glaze": {
            "type": "string",
            "description": "Glaze",
            "enum": [
              "ash",
              "sand"
            ]
          },
          "qty": {
            "type": "number",
            "description": "Quantity",
            "minimum": 1,
            "maximum": 9
          }
        },
        "required": [
          "sku",
          "size",
          "glaze",
          "qty"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "untrustedContentHint": false,
        "consequentialHint": false,
        "debugging": false
      },
      "exampleInput": {
        "sku": "cedar-mug",
        "size": "M",
        "glaze": "ash",
        "qty": 2
      },
      "plan": {
        "formSelector": "#add-to-cart",
        "resultTarget": "cart-summary",
        "fields": [
          {
            "name": "sku",
            "kind": "string",
            "required": true
          },
          {
            "name": "size",
            "kind": "string",
            "required": true
          },
          {
            "name": "glaze",
            "kind": "string",
            "required": true
          },
          {
            "name": "qty",
            "kind": "number",
            "required": true
          }
        ],
        "expect": {
          "method": "POST",
          "pathname": "/api/cart",
          "transport": "fetch",
          "status": 201,
          "responseKeys": [
            "line"
          ],
          "ui": "results"
        }
      },
      "order": 7
    },
