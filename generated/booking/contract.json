  "tools": [
    {
      "name": "search_slots",
      "title": "Search slots",
      "description": "Search slots. Recorded user flow submitted #search-slots via fetch GET /api/slots. Inputs: service (Service).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "description": "Service",
            "enum": [
              "cleaning",
              "exam"
            ]
          }
        },
        "required": [
          "service"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "untrustedContentHint": false,
        "consequentialHint": false,
        "debugging": false
      },
      "exampleInput": {
        "service": "cleaning"
      },
      "plan": {
        "formSelector": "#search-slots",
        "resultTarget": "slot-results",
        "fields": [
          {
            "name": "service",
            "kind": "string",
            "required": true
          }
        ],
        "expect": {
          "method": "GET",
          "pathname": "/api/slots",
          "transport": "fetch",
          "status": 200,
          "responseKeys": [
            "slots"
          ],
          "ui": "results"
        }
      },
      "order": 1
    },
    {
      "name": "book_visit",
      "title": "Book visit",
      "description": "Book visit. Recorded user flow submitted #book-visit via XMLHttpRequest POST /api/appointments. Inputs: service (Service), slot (Slot), patient (Patient), email (Email).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "description": "Service",
            "enum": [
              "cleaning",
              "exam"
            ]
          },
          "slot": {
            "type": "string",
            "description": "Slot",
            "enum": [
              "tue-0900",
              "tue-1300",
              "wed-1000"
            ]
          },
          "patient": {
            "type": "string",
            "description": "Patient"
          },
          "email": {
            "type": "string",
            "description": "Email",
            "format": "email"
          }
        },
        "required": [
          "service",
          "slot",
          "patient",
          "email"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "untrustedContentHint": false,
        "consequentialHint": true,
        "debugging": false
      },
      "exampleInput": {
        "service": "cleaning",
        "slot": "tue-0900",
        "patient": "Ada Lovelace",
        "email": "ada@analytical.example"
      },
      "plan": {
        "formSelector": "#book-visit",
        "resultTarget": "outcome",
        "fields": [
          {
            "name": "service",
            "kind": "string",
            "required": true
          },
          {
            "name": "slot",
            "kind": "string",
            "required": true
          },
          {
            "name": "patient",
            "kind": "string",
            "required": true
          },
          {
            "name": "email",
            "kind": "string",
            "required": true
          }
        ],
        "expect": {
          "method": "POST",
          "pathname": "/api/appointments",
          "transport": "xhr",
          "status": 201,
          "responseKeys": [
            "appointment"
          ],
          "ui": "outcome"
        }
      },
      "order": 7
    }
  ]
