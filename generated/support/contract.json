    "api": "document.modelContext",
    "methods": [
      "registerTool",
      "getTools",
      "executeTool"
    ],
    "event": "toolchange",
    "deprecatedAliasNotEmitted": "navigator.modelContext",
    "removedMethodsNotEmitted": [
      "provideContext",
      "clearContext"
    ],
    "polyfillPackage": "@mcp-b/webmcp-polyfill",
    "polyfillVersion": "6.0.3",
    "polyfillUpstreamRevision": "6bf6c57bbaf3d1173d7737cfb79572632d9b7871",
    "chromeDocsUpdated": "2026-10-16",
    "checkedOn": "2026-10-19"
  },
  "tools": [
    {
      "name": "search_articles",
      "title": "Search articles",
      "description": "Search articles. Recorded user flow submitted #search-articles via fetch GET /api/articles. Inputs: q (Question).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "description": "Question"
          }
        },
        "required": [
          "q"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "untrustedContentHint": false,
        "consequentialHint": false,
        "debugging": false
      },
      "exampleInput": {
        "q": "refund"
      },
      "plan": {
        "formSelector": "#search-articles",
        "resultTarget": "article-results",
        "fields": [
          {
            "name": "q",
            "kind": "string",
            "required": true
          }
        ],
        "expect": {
          "method": "GET",
          "pathname": "/api/articles",
          "transport": "fetch",
          "status": 200,
          "responseKeys": [
            "articles"
          ],
          "ui": "results"
        }
      },
      "order": 1
    },
    {
      "name": "file_ticket",
      "title": "File ticket",
      "description": "File ticket. Recorded user flow submitted #file-ticket via XMLHttpRequest POST /api/tickets. Inputs: email (Email), subject (Subject), body (What happened).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email",
            "format": "email"
          },
          "subject": {
            "type": "string",
            "description": "Subject"
          },
          "body": {
            "type": "string",
            "description": "What happened"
          }
        },
        "required": [
          "email",
          "subject",
          "body"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "untrustedContentHint": false,
        "consequentialHint": true,
        "debugging": false
      },
      "exampleInput": {
        "email": "ada@analytical.example",
        "subject": "Mug arrived cracked",
        "body": "The cedar mug arrived with a crack along the glaze."
      },
      "plan": {
        "formSelector": "#file-ticket",
        "resultTarget": "outcome",
        "fields": [
          {
            "name": "email",
            "kind": "string",
            "required": true
          },
          {
            "name": "subject",
            "kind": "string",
            "required": true
          },
          {
            "name": "body",
            "kind": "string",
            "required": true
          }
        ],
        "expect": {
          "method": "POST",
          "pathname": "/api/tickets",
          "transport": "xhr",
          "status": 201,
          "responseKeys": [
            "ticket"
          ],
          "ui": "outcome"
        }
      },
      "order": 6
    }
  ]
}