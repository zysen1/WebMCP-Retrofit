{
  "siteId": "pantry",
  "specPin": {
    "specRepo": "https://github.com/webmachinelearning/webmcp",
    "specCommit": "f14762e63607bf96592b1a7a6392cd2b047b8209",
    "specCommitDate": "2026-10-16",
    "specCommitMessage": "Editorial: sync explainers with spec (#350)",
    "api": "document.modelContext",
    "methods": [
      "registerTool",
      "getTools",
      "executeTool"
    ],
    "event": "toolchange",
    "deprecatedAliasNotEmitted": "navigator.modelContext",
    "removedMethodsNotEmitted": [
      "provideContext",
      "clearContext"
    ],
    "polyfillPackage": "@mcp-b/webmcp-polyfill",
    "polyfillVersion": "6.0.3",
    "polyfillUpstreamRevision": "6bf6c57bbaf3d1173d7737cfb79572632d9b7871",
    "chromeDocsUpdated": "2026-10-16",
    "checkedOn": "2026-10-19"
  },
  "tools": [
    {
      "name": "search_menu",
      "title": "Search menu",
      "description": "Search menu. Recorded user flow submitted #search-menu via fetch GET /api/menu. Inputs: diet (Diet).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "diet": {
            "type": "string",
            "description": "Diet",
            "enum": [
              "vegetarian",
              "fish"
            ]
          }
        },
        "required": [
          "diet"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "untrustedContentHint": false,
        "consequentialHint": false,
        "debugging": false
      },
      "exampleInput": {
        "diet": "vegetarian"
      },
      "plan": {
        "formSelector": "#search-menu",
        "resultTarget": "menu-results",
        "fields": [
          {
            "name": "diet",
            "kind": "string",
            "required": true
          }
        ],
        "expect": {
          "method": "GET",
          "pathname": "/api/menu",
          "transport": "fetch",
          "status": 200,
          "responseKeys": [
            "items"
          ],
          "ui": "results"
        }
      },
      "order": 1
    },
    {
      "name": "place_pantry_order",
      "title": "Place pantry order",
      "description": "Place pantry order. Recorded user flow submitted #place-pantry-order via fetch POST /api/orders. Inputs: item (Dish), qty (Quantity), name (Name), phone (Phone).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "description": "Dish",
            "enum": [
              "lentil",
              "trout",
              "greens"
            ]
          },
          "qty": {
            "type": "number",
            "description": "Quantity",
            "minimum": 1,
            "maximum": 6
          },
          "name": {
            "type": "string",
            "description": "Name"
          },
          "phone": {
            "type": "string",
            "description": "Phone"
          }
        },
        "required": [
          "item",
          "qty",
          "name",
          "phone"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "untrustedContentHint": false,
        "consequentialHint": true,
        "debugging": false
      },
      "exampleInput": {
        "item": "lentil",
        "qty": 2,
        "name": "Ada Lovelace",
        "phone": "206-555-0142"
      },
      "plan": {
        "formSelector": "#place-pantry-order",
        "resultTarget": "outcome",
        "fields": [
          {
            "name": "item",
            "kind": "string",
            "required": true
          },
          {
            "name": "qty",
            "kind": "number",
            "required": true
          },
          {
            "name": "name",
            "kind": "string",
            "required": true
          },
          {
            "name": "phone",
            "kind": "string",
            "required": true
          }
        ],
        "expect": {
          "method": "POST",
          "pathname": "/api/orders",
          "transport": "fetch",
          "status": 201,
          "responseKeys": [
            "receipt"
          ],
          "ui": "outcome"
        }
      },
      "order": 7
    }
  ]
}